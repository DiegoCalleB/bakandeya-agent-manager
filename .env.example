# Configuración de Google Sheets (Service Account)
GOOGLE_APPLICATION_CREDENTIALS=credentials_service_account.json
GOOGLE_SHEETS_DOCUMENT=Bakandeya Leads

# Configuración de Gmail API (OAuth Desktop)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# API de Claude (Anthropic)
ANTHROPIC_API_KEY=tu_api_key_de_anthropic

# API de Gemini (Google AI Studio)
GEMINI_API_KEY=tu_api_key_de_gemini

# Notificaciones de Telegram
TELEGRAM_BOT_TOKEN=tu_bot_token_de_telegram
TELEGRAM_CHAT_ID=tu_chat_id_de_telegram

# Webhook de feedback para el chatbot
CHATBOT_WEBHOOK_URL=https://tu-servidor-chatbot.com/api/webhooks/scout

# API de YouTube
YOUTUBE_API_KEY=tu_youtube_api_key
YOUTUBE_CHANNEL_ID=tu_youtube_channel_id

